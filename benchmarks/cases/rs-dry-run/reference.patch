--- a/src/args.rs
+++ b/src/args.rs
@@ -1,4 +1,6 @@
-pub fn run(args:Vec<String>)->Result<(),Box<dyn std::error::Error>> {
-    if args.len()!=2 {return Err("expected FILE VALUE".into());}
-    println!("{}",rs_dry_run::set_value(std::path::Path::new(&args[0]),&format!("{}\n",args[1]))?);Ok(())
+pub fn run(mut args:Vec<String>)->Result<(),Box<dyn std::error::Error>> {
+    let dry=args.first().is_some_and(|arg|arg=="--dry-run");
+    if dry {args.remove(0);}
+    if args.len()!=2 {return Err("expected [--dry-run] FILE VALUE".into());}
+    println!("{}",rs_dry_run::update(std::path::Path::new(&args[0]),&format!("{}\n",args[1]),dry)?);Ok(())
 }
